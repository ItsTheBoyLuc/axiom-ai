# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL. docker compose builds its own DATABASE_URL from these (host = service name `postgres`).
POSTGRES_USER=axiom
POSTGRES_PASSWORD=change-me-postgres
# Password of the least-privilege role the web and worker connect as (docker/initdb/01-app-role.sh).
APP_DB_PASSWORD=change-me-app-role
POSTGRES_DB=axiom
# Used when running `npm run dev` / prisma on the host against the compose postgres
DATABASE_URL=postgresql://axiom:change-me-postgres@localhost:5432/axiom

# Redis (host access; compose uses redis://redis:6379 internally)
REDIS_URL=redis://localhost:6379

# Sessions are random tokens stored hashed in PostgreSQL, so there is no signing secret to manage.

# Public API budget per client address per minute (0 disables). Default 240.
API_RATE_LIMIT_PER_MINUTE=

# Which request header carries the client address for rate limiting (set by your reverse proxy).
# Default x-forwarded-for; behind Cloudflare use cf-connecting-ip. Never expose the app directly.
CLIENT_IP_HEADER=

# Worker
WORKER_HEALTH_PORT=3001
# Optional: a GitHub token (no scopes needed) raises the API rate limit of the github-releases
# sync adapter from 60 to 5000 requests/hour. Leave empty to run unauthenticated.
GITHUB_TOKEN=

# Public contact address, shown on /contact and in the privacy policy (the page says so when unset).
CONTACT_EMAIL=

# Set to true to allow the scroll debug overlay (?debug=scroll on the home page) in a production build.
# Always available in development; leave unset in production.
ENABLE_DEBUG_OVERLAY=

# Optional social links (footer hides unset ones)
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_X=

# Host port mappings for docker compose (change if the defaults are taken)
WEB_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
# Interface the web port is published on. Loopback unless you know why not (docs/DEPLOYMENT.md).
WEB_BIND=127.0.0.1
# Cloudflare Tunnel token, only for `docker compose --profile tunnel up -d`.
TUNNEL_TOKEN=
